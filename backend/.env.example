# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env.

# Supabase project (used only for auth storage and the admin API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Brevo transactional email
BREVO_API_KEY=YOUR_BREVO_API_V3_KEY
BREVO_SENDER_EMAIL=verified-sender@yourdomain.com
BREVO_SENDER_NAME=NexaFlow

# Random string used to hash OTP codes at rest
OTP_PEPPER=replace-with-a-long-random-string
